# Copy to ai_service/.env and fill in. Never commit the real .env.
AI_POSTGRES_PASSWORD=change-me
AI_DATABASE_URL=postgresql://ppa_ai:change-me@127.0.0.1:5434/ppa_ai
AI_ENV=development

# ---- LLM providers (paste your keys; never commit this file) ----
# Groq: generates chat answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini: embeddings for RAG, and fallback chat model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Optional tuning (defaults shown) ----
# GEMINI_EMBED_TEXTS_PER_MINUTE=90
# RAG_TOP_K=5
# RAG_KEYWORD_WEIGHT=0.5
# RAG_CHUNK_MAX_TOKENS=350
# RAG_CHUNK_OVERLAP_TOKENS=60

# ---- Assistant (defaults shown) ----
# AI_ENABLED=true
# FLASK_API_URL=http://127.0.0.1:5000
# AUTH_CACHE_SECONDS=30
# LLM_TIMEOUT_SECONDS=20
# ANSWER_MAX_TOKENS=700
# CONTEXT_MAX_TOKENS=1800
# RAG_MIN_RELEVANCE=0.61
# QUESTION_MAX_CHARS=500
# ASSISTANT_DAILY_REQUESTS=50
# ASSISTANT_DAILY_TOKENS=60000
# ASSISTANT_REQUESTS_PER_MINUTE=6

# ---- My-data mode and logging (defaults shown) ----
# FLASK_DATA_TIMEOUT_SECONDS=5
# AI_LOG_LEVEL=INFO
# AI_LOG_FORMAT=text   # text locally; json is the default when AI_ENV=production
# AI_CORS_ORIGINS=http://localhost:3000   # comma-separated; add the Vercel URL when deployed

# Testing phase: false switches off the per-user daily caps (ASSISTANT_DAILY_REQUESTS and
# ASSISTANT_DAILY_TOKENS); usage is still counted and shown. Keep true in production.
# ASSISTANT_LIMITS_ENABLED=true
# Groq free-tier daily tokens for the model (whole account); the panel's % left uses it when caps are off.
# GROQ_FREE_DAILY_TOKENS=200000
